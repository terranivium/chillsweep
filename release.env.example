# Template for release.env — copy it and fill in the blanks:
#
#     cp release.env.example release.env        (Git Bash)
#     copy release.env.example release.env      (cmd / PowerShell)
#
# release.env is GITIGNORED and never leaves this machine. The build scripts load it themselves
# (build-scripts/github.mjs); real environment variables of the same name win over it.
#
# Only `npm run release`, `release:check`, `release-notes` and `changelog:promote` need any of this.
# Plain `npm run build` runs offline and needs none of it.


# ── GitHub ───────────────────────────────────────────────────────────────────
# Creates the draft release on github.com/terranivium/chillsweep and uploads the installer to it.
#
# Use a FINE-GRAINED personal access token limited to that one repository, with
# "Contents: Read and write" — enough to create a release and attach assets.
#
# Fine-grained tokens expire. If a release suddenly fails with a 401 months from now, check the
# expiry date before anything else.
GH_TOKEN=


# ── Updater signing ──────────────────────────────────────────────────────────
# Signs the installer so installed copies accept it as an update. Generated once with:
#
#     npm run tauri signer generate -- -w "$HOME/.tauri/chillsweep.key"
#
# Point this at the private key file, e.g. C:\Users\<you>\.tauri\chillsweep.key (a path works; so
# does the key's contents). Its public half goes
# in src-tauri/tauri.conf.json → plugins.updater.pubkey.
#
# BACK THE KEY UP. If it's lost, every installed copy stops accepting updates for good: the only fix
# is asking users to download and reinstall by hand.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
