{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChillSweep",
  "version": "1.0.0",
  "identifier": "com.chillsweep.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": { "script": "node build-scripts/changelog-json.mjs", "wait": true },
    "beforeBuildCommand": "node build-scripts/changelog-json.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChillSweep",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBODY3NTVDMDU2MjI5ODUKUldTRktXSUZYSFdHK3VYQWkrVUN5b21SZ0FIM0RHV1JNUGdyS2sxRm1zelAreURBYytWVTYvYkEK",
      "endpoints": [
        "https://github.com/terranivium/chillsweep/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
